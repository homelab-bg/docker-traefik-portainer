# Network, Host/Port details for Traefik & Portainer
NETWORK=traefik
#DNS_RESOLVER=9.9.9.9
MONITORING_STACK=your-monitoring-stack-name

# Where Traefik/Portainer store persistent data. Defaults to a local bind
# mount for standalone testing - point this at shared/durable storage (e.g.
# a CephFS mount) for anything meant to survive a host rebuild.
DATA_DIR=./data

# Traefik Configuration
# v3.6.0+ required - Docker 29 raised its minimum supported API version, and
# Traefik versions before v3.6.x are hardcoded to the old v1.24 client (no
# DOCKER_API_VERSION workaround - confirmed via traefik/traefik#12253 and the
# Traefik Labs community forum). v3.6.x added API version auto-negotiation.
TRAEFIK_VER=v3.7.10
TRAEFIK_HOST=traefik.example.com

# Portainer Configuration
PORTAINER_EDITION=ce
PORTAINER_VER=2.33.1
PORTAINER_HOST=portainer.example.com
PORTAINER_PORT=9000

# AWS credentials for Traefik's Route53 DNS challenge - NOT set here.
# Create secrets/aws_credentials (gitignored) instead, in the standard AWS
# credentials file format:
#   [default]
#   aws_access_key_id = ...
#   aws_secret_access_key = ...
# Plain env vars are visible via `docker inspect`; a mounted secrets file
# isn't. AWS_REGION/AWS_HOSTED_ZONE_ID aren't secret, so they stay env vars.
AWS_REGION=your-region
#AWS_HOSTED_ZONE_ID=

# Let's Encrypt Email (REQUIRED)
LETSENCRYPT_EMAIL=admin@example.com

# dnsweaver - auto-creates DNS for anything with a Traefik Host() label
# matching DNSWEAVER_DOMAINS. On by default (COMPOSE_PROFILES below); blank
# that out or override at the CLI (--profile "") to skip it, e.g. on a
# fresh bootstrap before secrets/technitium_token is provisioned.
COMPOSE_PROFILES=dnsweaver
DNSWEAVER_VER=v2.7.3
TECHNITIUM_URL=https://ns1.example.internal
DNSWEAVER_ZONE=example.internal
DNSWEAVER_DOMAINS=*.example.internal
# Create secrets/technitium_token (gitignored) with a Technitium API token,
# scoped to just DNSWEAVER_ZONE if your Technitium instance's permission
# model supports it (it does - per-zone ACLs assigned to a dedicated user).
